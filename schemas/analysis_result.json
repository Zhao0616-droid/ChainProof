{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chainproof.dev/schemas/analysis_result.json",
  "title": "AnalysisResult — 最终产物",
  "description": "唯一契约 ②。冻结于 Day 1,任何字段名/类型的改动必须三方共同确认。字段归属:contract/analysis(除 model_version)/findings 核心字段/unverified 由 A 填;analysis.model_version、findings[].explanation、findings[].patch 由 B 填;C 只读渲染。",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "analysis", "findings", "unverified"],
  "properties": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "hash", "compiler"],
      "properties": {
        "name": { "type": "string" },
        "hash": { "type": "string" },
        "compiler": { "type": "string" }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "coverage", "duration_ms"],
      "properties": {
        "status": { "enum": ["done", "partial", "timeout", "failed"] },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["proved", "total"],
          "properties": {
            "proved": { "type": "integer", "minimum": 0 },
            "total": { "type": "integer", "minimum": 0 }
          }
        },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "model_version": { "type": "string" }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "swc", "type", "severity", "location", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "swc": { "type": "string" },
          "type": { "type": "string" },
          "severity": { "enum": ["high", "medium", "low", "info"] },
          "location": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "line", "function"],
            "properties": {
              "file": { "type": "string" },
              "line": { "type": "integer", "minimum": 1 },
              "function": { "type": "string" }
            }
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "smt_status"],
            "properties": {
              "kind": { "enum": ["formal", "counterexample", "pattern"] },
              "smt_status": { "enum": ["sat", "unsat", "unknown"] },
              "counterexample": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true,
                  "required": ["step", "state"],
                  "properties": {
                    "step": { "type": "integer", "minimum": 1 },
                    "state": { "type": "object" }
                  }
                }
              },
              "proof_ref": { "type": "string" }
            }
          },
          "explanation": { "type": "string" },
          "patch": {
            "type": "object",
            "additionalProperties": false,
            "required": ["diff", "verified"],
            "properties": {
              "diff": { "type": "string" },
              "verified": { "type": "boolean" }
            }
          }
        }
      }
    },
    "unverified": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reason", "scope"],
        "properties": {
          "reason": { "type": "string" },
          "scope": { "type": "string" }
        }
      }
    }
  }
}
